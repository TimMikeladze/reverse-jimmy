{
	"name": "reverse-jimmy",
	"version": "0.1.0",
	"description": "Unofficial minimal TypeScript client for chatjimmy.ai (llama3.1-8B): streaming, batching, rate limiting, retries, and user-agent/proxy rotation",
	"keywords": [
		"ai",
		"api-client",
		"batching",
		"bun",
		"chat",
		"chatjimmy",
		"chatjimmy.ai",
		"jimmy",
		"llama",
		"llama3.1",
		"llm",
		"proxy",
		"rate-limit",
		"rate-limiting",
		"retry",
		"sdk",
		"streaming",
		"typescript",
		"user-agent"
	],
	"homepage": "https://github.com/TimMikeladze/reverse-jimmy#readme",
	"bugs": {
		"url": "https://github.com/TimMikeladze/reverse-jimmy/issues"
	},
	"license": "MIT",
	"author": "TimMikeladze",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/reverse-jimmy.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp --commit --push --tag",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"bumpp": "^12.2.2",
		"bunup": "^0.16.32",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run type-check"
	},
	"engines": {
		"bun": ">=1.1",
		"node": ">=20.3"
	}
}
